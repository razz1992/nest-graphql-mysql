NODE_ENV=development
PORT=3000

MYSQL_DB_HOST=localhost
MYSQL_DB_PORT=3306
MYSQL_DB_USER=root
MYSQL_DB_PASSWORD=change-me
# Alternatively, set MYSQL_DB_PASSWORD_FILE to the path to a mounted secret file.
MYSQL_DB_NAME=graphql_demo

# Optional MySQL TLS CA path. Set this when connecting to a TLS-enabled external DB
# (for example, Aiven); the CA is used with certificate verification enabled.
MYSQL_SSL_CA_PATH=

# Set both values to enable HTTPS for the NestJS HTTP listener.
# SSL_KEY_PATH=./certs/server.key
# SSL_CERT_PATH=./certs/server.crt
# SSL_PASSPHRASE=
