#!/bin/bash
set -euo pipefail
umask 077
exec > >(tee -a /var/log/user-data-deploy.log | logger -t user-data -s 2>/dev/console) 2>&1

REGION='${aws_region}'
APP_DIR='${app_directory}'
REPOSITORY_URL='${repository_url}'
REPOSITORY_REF='${repository_ref}'
COMPOSE_VERSION='${docker_compose_version}'
PASSWORD_PARAMETER='${mysql_password_parameter_name}'
CA_PARAMETER='${mysql_ca_parameter_name}'

log() { printf '[bootstrap] %s\n' "$1"; }
log "Installing Docker, Git, curl and AWS CLI in ${aws_region}."
dnf update -y
dnf install -y docker git curl awscli-2
systemctl enable --now docker

NETWORK_READY=0
for attempt in $(seq 1 40); do
  if timeout 4 bash -c '</dev/tcp/amazonlinux.com/443' 2>/dev/null; then
    NETWORK_READY=1
    break
  fi
  sleep 3
done
if [ "$NETWORK_READY" -ne 1 ]; then
  log "ERROR: No outbound network after waiting for Elastic IP association."
  exit 1
fi

install -d -m 0755 /usr/local/lib/docker/cli-plugins
cd /tmp
curl --fail --silent --show-error --location \
  "https://github.com/docker/compose/releases/download/${COMPOSE_VERSION}/docker-compose-linux-x86_64" \
  --output docker-compose-linux-x86_64
curl --fail --silent --show-error --location \
  "https://github.com/docker/compose/releases/download/${COMPOSE_VERSION}/docker-compose-linux-x86_64.sha256" \
  --output docker-compose-linux-x86_64.sha256
sha256sum --check docker-compose-linux-x86_64.sha256
install -o root -g root -m 0755 docker-compose-linux-x86_64 /usr/local/lib/docker/cli-plugins/docker-compose
/usr/bin/docker compose version

if [ -d "$APP_DIR/.git" ]; then
  git -C "$APP_DIR" fetch --all --tags --prune
else
  install -d -m 0755 "$(dirname "$APP_DIR")"
  git clone "$REPOSITORY_URL" "$APP_DIR"
fi
git -C "$APP_DIR" checkout --force "$REPOSITORY_REF"

install -d -o root -g root -m 0755 "$APP_DIR/certs"
install -d -o root -g root -m 0750 "$APP_DIR/secrets"
PASSWORD_VALUE=''
for attempt in $(seq 1 30); do
  PASSWORD_VALUE="$(aws ssm get-parameter --region "$REGION" --name "$PASSWORD_PARAMETER" --with-decryption --query 'Parameter.Value' --output text 2>/dev/null || true)"
  if [ -n "$PASSWORD_VALUE" ] && [ "$PASSWORD_VALUE" != "None" ]; then break; fi
  log "Waiting for the pre-created SSM password parameter (attempt $attempt/30)."
  sleep 10
done
if [ -z "$PASSWORD_VALUE" ] || [ "$PASSWORD_VALUE" = "None" ]; then
  log "ERROR: Could not retrieve SSM SecureString parameter."
  exit 1
fi
printf '%s' "$PASSWORD_VALUE" > "$APP_DIR/secrets/mysql_db_password"
unset PASSWORD_VALUE
chown 10001:10001 "$APP_DIR/secrets/mysql_db_password"
chmod 0400 "$APP_DIR/secrets/mysql_db_password"

if ! aws ssm get-parameter --region "$REGION" --name "$CA_PARAMETER" --query 'Parameter.Value' --output text > "$APP_DIR/certs/mysql-ca.pem" 2>/dev/null; then
  log "ERROR: Could not retrieve SSM CA parameter."
  exit 1
fi
if ! grep -q 'BEGIN CERTIFICATE' "$APP_DIR/certs/mysql-ca.pem"; then
  log "ERROR: SSM CA parameter is not a PEM certificate."
  exit 1
fi
chown root:root "$APP_DIR/certs/mysql-ca.pem"
chmod 0644 "$APP_DIR/certs/mysql-ca.pem"

cat > "$APP_DIR/.env.prod" <<'APP_ENV'
NODE_ENV=production
PORT=8085
MYSQL_DB_HOST=${mysql_db_host}
MYSQL_DB_PORT=${mysql_db_port}
MYSQL_DB_USER=${mysql_db_user}
MYSQL_DB_NAME=${mysql_db_name}
MYSQL_DB_PASSWORD_FILE=/run/secrets/mysql_db_password
MYSQL_SSL_CA_PATH=/run/mysql-ca/mysql-ca.pem
APP_ENV
chmod 0600 "$APP_DIR/.env.prod"

cat > /etc/systemd/system/${project_name}-compose.service <<'SERVICE'
[Unit]
Description=${project_name} Docker Compose application
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=${app_directory}
ExecStart=/usr/bin/docker compose --env-file .env.prod up --build --detach
ExecStop=/usr/bin/docker compose --env-file .env.prod down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
SERVICE

systemctl daemon-reload
systemctl enable --now ${project_name}-compose.service
log "Bootstrap complete. API may retry until Elastic IP is allowlisted in Aiven."
